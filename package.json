{
  "name": "splitwise-mcp",
  "version": "0.1.0",
  "description": "MCP server for Splitwise: manage shared expenses, balances and settle-ups from Claude, Cursor and other MCP clients.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "splitwise",
    "claude",
    "cursor",
    "mcp-server",
    "expenses",
    "llm",
    "ai-tools"
  ],
  "homepage": "https://github.com/prakhar083/splitwise-mcp#readme",
  "bugs": {
    "url": "https://github.com/prakhar083/splitwise-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prakhar083/splitwise-mcp.git"
  },
  "license": "MIT",
  "author": "Prakhar Vijay",
  "type": "module",
  "bin": {
    "splitwise-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^4.1.12",
    "@types/node": "^20.19.0"
  }
}
